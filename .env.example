# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement de PTH. Copier ce fichier vers `.env.local` (local) et les saisir
# chez l'hébergeur (production). JAMAIS de clé dans le code, dans git ou dans une conversation.
# Guide pas à pas pour créer chaque compte : docs/19-backend.md
# ─────────────────────────────────────────────────────────────────────────────

# Adresse publique du site (SEO, liens des emails, retours de paiement). Sans slash final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Emails (Resend) ── obligatoire pour recevoir les demandes par email
RESEND_API_KEY=
# Adresse qui REÇOIT les demandes
PTH_CONTACT_EMAIL=
# Expéditeur (domaine vérifié chez Resend). En test : onboarding@resend.dev
PTH_FROM_EMAIL=onboarding@resend.dev

# ── Base de données des demandes (Supabase) ── recommandé (les demandes ne se perdent jamais)
SUPABASE_URL=
# Clé « service_role » : SECRÈTE, serveur uniquement, jamais dans NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# ── Anti-robots invisible (Cloudflare Turnstile) ── optionnel mais conseillé
# La clé PUBLIQUE est inscrite dans le code au build ; la clé SECRÈTE reste sur le serveur.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Dons en ligne ──
# Fournisseur : "stripe" | "helloasso" | vide (= pas de paiement en ligne, formulaire de contact classique)
DONATION_PROVIDER=
# Passer à "true" pour afficher le choix du montant dans le formulaire (inscrit au build)
NEXT_PUBLIC_DONATIONS_ENABLED=false
# Stripe — montant libre des deux côtés (ponctuel ET mensuel) : aucun Price ID à créer dans le Dashboard, Stripe
# génère le prix à la volée à partir du montant choisi. Procédure complète : docs/19-backend.md « Configuration
# Stripe — dons ».
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Liens de paiement Stripe, résolus côté serveur. Laisser vide pour utiliser la Session Checkout dynamique.
STRIPE_DONATION_ONCE_20_URL=
STRIPE_DONATION_ONCE_50_URL=
STRIPE_DONATION_ONCE_100_URL=
STRIPE_DONATION_ONCE_150_URL=
STRIPE_DONATION_ONCE_CUSTOM_URL=
STRIPE_DONATION_MONTHLY_20_URL=
STRIPE_DONATION_MONTHLY_50_URL=
STRIPE_DONATION_MONTHLY_100_URL=
STRIPE_DONATION_MONTHLY_150_URL=
# HelloAsso : lien de votre formulaire de don (reçus fiscaux gérés par HelloAsso)
HELLOASSO_DONATION_URL=

# ── Page /projets, bloc « Devenir partenaire » ── vide = bouton correspondant masqué (jamais inventé)
PTH_PROJECT_CONTACT_EMAIL=
PTH_CALENDAR_URL=

# ── Espace admin (/admin) ── désactivé (404) tant que les deux ne sont pas définis
# Mot de passe long et unique ; secret ≥ 16 caractères aléatoires (ex. `openssl rand -base64 32`)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Divers ──
# Sel des empreintes d'IP (par défaut : ADMIN_SESSION_SECRET). Changer = les anciennes empreintes ne correspondent plus.
IP_HASH_SALT=
# Analytics (à définir) — ex. domaine Plausible
NEXT_PUBLIC_ANALYTICS_DOMAIN=


DONATION_PROVIDER=stripe
NEXT_PUBLIC_DONATIONS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
